# Copy this to `.env` and replace placeholders with your real keys.
# Do NOT commit your real `.env` to source control.

# Lovable gateway API key (optional)
LOVABLE_API_KEY=your-lovable-api-key-here

# Google GenAI API key (optional)
GOOGLE_API_KEY=your-google-api-key-here

# Other env variables used by the app
# NODE_ENV=development
# PORT=8080
